{
  "name": "pi-ui",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal single-chat web UI for pi, installable as a PWA with a native share target",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@hono/node-server": "2.1.5",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.14",
    "pi-web-access": "0.44.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
